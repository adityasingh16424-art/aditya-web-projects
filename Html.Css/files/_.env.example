# ─── BLACK ROBINE · environment variables ───────────────────────────────
# Copy to .env.local (app) and .env (Prisma CLI). Never commit real values.

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="BLACK ROBINE"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blackrobine?schema=public"

# Auth.js  (generate: npx auth secret   or   openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Cloudinary (server secret stays server-side)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Razorpay — use TEST keys until go-live
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email (SMTP — any provider)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="BLACK ROBINE <orders@your-domain.com>"

# Rate limiting (optional in dev; required in production)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Scheduled job auth (release expired stock reservations)
CRON_SECRET=""

# Dev-only seed (prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@blackrobine.local"
SEED_ADMIN_PASSWORD=""
